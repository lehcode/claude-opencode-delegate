#!/usr/bin/env bash
set -euo pipefail

# pre-commit: lint and format-check staged files only.
# Skips if no staged files or only non-code docs changed.

echo "🔍 Running pre-commit hooks..."

# Get staged files (add, copy, modify)
STAGED=$(git diff --cached --name-only --diff-filter=ACM)
if [ -z "$STAGED" ]; then
  echo "  (no staged files, skipping)"
  exit 0
fi

# 1. Prettier format check on relevant staged files
FORMAT_FILES=$(echo "$STAGED" | grep -E '\.(ts|js|json|md|yml|yaml)$' || true)
if [ -n "$FORMAT_FILES" ]; then
  echo "  🎨 Prettier format check..."
  npx prettier --check $FORMAT_FILES
  echo "  ✓ Prettier check passed"
else
  echo "  (no formatable files staged, skipping)"
fi

# 2. ESLint on staged .ts files only (core lib only)
TS_FILES=$(echo "$STAGED" | grep -E '^\s*src/.*\.ts$' || true)
if [ -n "$TS_FILES" ]; then
  echo "  📋 ESLint on staged files..."
  npx eslint $TS_FILES
  echo "  ✓ ESLint passed"
else
  echo "  (no .ts files in src/ staged, skipping)"
fi

# 3. Vale prose lint
PROSE_FILES=$(echo "$STAGED" | grep -E '^[^/]+\.md$|^docs/.+\.md$' | grep -vE '(^|/)(\.atl|plans?|odd)/' | grep -vE '^(CHANGELOG|CLAUDE|AGENTS)\.md$' || true)
if [ -z "$PROSE_FILES" ]; then
  echo "  (no prose files staged, skipping)"
elif ! command -v vale >/dev/null 2>&1; then
  echo "  ⚠ vale not found, skipping prose lint (install: https://vale.sh)"
else
  if [ ! -d .vale/styles/Microsoft ]; then
    vale --no-global sync
  fi
  echo "  📝 Vale prose lint..."
  vale --no-global $PROSE_FILES
  echo "  ✓ Vale passed"
fi

echo "✅ Pre-commit hooks passed"
exit 0
