{
  "name": "claudelegate",
  "version": "0.2.2",
  "description": "Delegate tasks from Claude to any OpenCode model (Grok, Kimi, GLM, Qwen, DeepSeek, MiMo…) while Claude stays the orchestrator.",
  "author": {
    "name": "aashahin",
    "url": "https://github.com/aashahin"
  },
  "homepage": "https://github.com/lehcode/claudelegate",
  "repository": "https://github.com/lehcode/claudelegate",
  "license": "MIT",
  "hooks": "./plugin-hooks/hooks.json",
  "mcpServers": {
    "opencode": {
      "command": "bun",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/dist/index.js"
      ]
    }
  },
  "keywords": [
    "opencode",
    "delegate",
    "subagent",
    "grok",
    "kimi",
    "glm",
    "qwen",
    "deepseek"
  ]
}
