{
  "name": "claude-opencode-delegate",
  "version": "0.1.0",
  "description": "Claude Code plugin — delegate tasks to any OpenCode model (Grok, Kimi, GLM, Qwen, DeepSeek…) via agent activation, while Claude stays the orchestrator.",
  "type": "module",
  "license": "MIT",
  "author": "aashahin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aashahin/claude-opencode-delegate.git"
  },
  "keywords": [
    "claude",
    "claude-code",
    "opencode",
    "subagent",
    "delegate"
  ],
  "files": [
    "src",
    "skills",
    "agents",
    "commands",
    ".claude-plugin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.1"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "eslint . --max-warnings 0",
    "fmt": "prettier --check \"**/*.{ts,js,json,md,yml,yaml}\"",
    "fmt:fix": "prettier --write \"**/*.{ts,js,json,md,yml,yaml}\"",
    "verify": "bun run typecheck && bun test && bun run lint && bun run fmt"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.71.1"
  }
}
