{
  "name": "@lehcode/claude-opencode-delegate",
  "version": "0.1.0",
  "description": "Claude Code plugin — delegate tasks to any OpenCode model (Grok, Kimi, GLM, Qwen, DeepSeek…) via agent activation, while Claude stays the orchestrator.",
  "type": "module",
  "license": "MIT",
  "author": "aashahin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lehcode/claude-opencode-delegate.git"
  },
  "homepage": "https://github.com/lehcode/claude-opencode-delegate#readme",
  "bugs": {
    "url": "https://github.com/lehcode/claude-opencode-delegate/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "opencode",
    "subagent",
    "delegate",
    "mcp"
  ],
  "bin": {
    "claude-opencode-delegate": "dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "skills",
    "agents",
    "commands",
    ".claude-plugin",
    "scripts",
    "plugin-hooks",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.1"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --target=bun --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "eslint . --max-warnings 0",
    "fmt": "prettier --check \"**/*.{ts,js,json,md,yml,yaml}\"",
    "fmt:fix": "prettier --write \"**/*.{ts,js,json,md,yml,yaml}\"",
    "verify": "bun run typecheck && bun test && bun run lint && bun run fmt"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.71.1"
  }
}
